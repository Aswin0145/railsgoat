pipeline {
  agent any
  stages {
    stage('prerequisites check') {
      steps {
        sh '''
          echo "--- Checking Python & Pip Readiness ---"
          python3 --version
          pip3 --version
          echo "--- Checking VENV Readiness ---"
          python3 -m venv --help > /dev/null && echo "venv module is present"
          echo "--- Checking Docker Readiness ---"
          docker ps
        '''
      }
    }
    stage('Bomanai QA') {
      steps {
        sh '''
          pip install "setuptools<70"
          pip install --extra-index-url https://test.pypi.org/simple/ --upgrade boman-cli-uat
          boman-cli-uat -a run -u https://qa.boman.ai -at fe08c16b-1f8a-418f-95c2-a86f6d6b1c60 -ct 1d747e85-40c3-4e2c-98ff-6af0ed1a721f
        '''
      }
    }
  }
}
